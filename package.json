{
  "name": "exit-bookmarks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180",
    "build": "tsc -b && vite build && node scripts/personalization.mjs --build && node scripts/licenses.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4180",
    "lint": "eslint . && tsc -b",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "node scripts/check.mjs",
    "test:personalization": "node scripts/personalization-e2e.mjs",
    "dev:personalized": "node scripts/personalization.mjs --personalized && vite --host 127.0.0.1 --port 4180",
    "build:personalized": "tsc -b && vite build && node scripts/personalization.mjs --build --personalized && node scripts/licenses.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.25",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.12",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "playwright": "^1.56.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
