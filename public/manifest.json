{
  "manifest_version": 3, "name": "EXIT. — Your Web, in Order.", "version": "0.1.0", "minimum_chrome_version": "120",
  "description": "Your Web, in Order. 以 Chrome 原生书签为唯一来源的私人入口。",
  "permissions": ["bookmarks", "storage"],
  "action": {"default_title": "打开 EXIT.", "default_icon": {"16":"icons/icon16.png", "32":"icons/icon32.png"}},
  "icons": {"16":"icons/icon16.png", "32":"icons/icon32.png", "48":"icons/icon48.png", "128":"icons/icon128.png"},
  "background": {"service_worker":"background.js", "type":"module"},
  "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'none'; connect-src 'self'; base-uri 'none'"}
}
